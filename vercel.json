{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/main.rs": {
      "includeFiles": "templates/**,static/**,data/**,job_data/**,blog_data/**,AI_Eco_Blogs/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/main"
    }
  ]
}
